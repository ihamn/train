    {
      "kind": "control",
      "name": "FROW0",
      "field": "active",
      "equals": true,
      "at": 1.2
    },
    {
      "kind": "control",
      "name": "FROW26",
      "field": "active",
      "equals": true,
      "at": 1.2
    },
    {
      "kind": "lua",
      "at": 1.2,
      "source": "local n = 0\nfor i = 0, 26 do\n  local c = query.control('FROW' .. i)\n  assert(c ~= nil, 'FROW' .. i .. ' missing')\n  assert(c.active == true, 'FROW' .. i .. ' inactive')\n  n = n + 1\nend\nassert(n == 27, 'expected 27 rows, got ' .. n)\nassert(query.logContains('rowStep='), 'no rowStep log')\nassert(query.logContains('rowsBuilt='), 'no rowsBuilt log')"
    }
  ]
